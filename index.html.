<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>imadeadhd</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background: #080808;
      color: white;
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .background {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 50% 40%, #252525 0%, #101010 35%, #050505 75%);
      z-index: -2;
    }

    .background::after {
      content: "";
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.35);
      z-index: -1;
    }

    .profile {
      width: min(600px, 92%);
      text-align: center;
      padding: 35px 25px;
    }

    .avatar {
      width: 105px;
      height: 105px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,.15);
      box-shadow: 0 0 35px rgba(255,255,255,.12);
      margin-bottom: 18px;
    }

    h1 {
      font-size: 32px;
      font-weight: 700;
      letter-spacing: -1px;
    }

    .username {
      color: #888;
      margin-top: 7px;
      font-size: 15px;
    }

    .bio {
      margin: 22px auto;
      color: #ccc;
      font-size: 15px;
      line-height: 1.6;
      max-width: 480px;
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 25px;
    }

    .link {
      display: block;
      text-decoration: none;
      color: white;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.10);
      padding: 15px;
      border-radius: 12px;
      transition: .2s;
      backdrop-filter: blur(10px);
    }

    .link:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,.11);
      border-color: rgba(255,255,255,.2);
    }

    .stats {
      display: flex;
      justify-content: center;
      gap: 35px;
      margin-top: 28px;
      color: #888;
      font-size: 13px;
    }

    .stats strong {
      display: block;
      color: white;
      font-size: 16px;
      margin-bottom: 3px;
    }

    .footer {
      margin-top: 35px;
      color: #555;
      font-size: 12px;
    }
  </style>
</head>

<body>

  <div class="background"></div>

  <main class="profile">

    <!-- CHANGE THIS IMAGE URL TO YOUR PROFILE PICTURE -->
    <img
      class="avatar"
      src="https://i.imgur.com/placeholder.png"
      alt="Profile picture"
    >

    <h1>imadeadhd</h1>

    <div class="username">@imadeadhd</div>

    <p class="bio">
      welcome to my profile<br>
      gaming • discord • roblox
    </p>

    <div class="links">

      <a class="link" href="https://discord.com/" target="_blank">
        Discord
      </a>

      <a class="link" href="https://www.roblox.com/" target="_blank">
        Roblox
      </a>

      <a class="link" href="https://guns.lol/imadeadhd" target="_blank">
        guns.lol
      </a>

    </div>

    <div class="stats">
      <div>
        <strong>16</strong>
        Age
      </div>

      <div>
        <strong>🇦🇺</strong>
        Australia
      </div>

      <div>
        <strong>∞</strong>
        Online
      </div>
    </div>

    <div class="footer">
      imadeadhd.com
    </div>

  </main>

</body>
</html>
