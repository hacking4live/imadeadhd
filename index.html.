<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>imadeadhd</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background: #080808;
      color: white;
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .background {
      position: fixed;
      inset: 0;
      background: radial-gradient(
        circle at 50% 40%,
        #252525 0%,
        #101010 35%,
        #050505 75%
      );
      z-index: -1;
    }

    .profile {
      width: min(600px, 92%);
      text-align: center;
      padding: 35px 25px;
    }

    .avatar {
      width: 105px;
      height: 105px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.15);
      margin-bottom: 18px;
    }

    h1 {
      font-size: 32px;
      font-weight: 700;
    }

    .username {
      color: #888;
      margin-top: 7px;
      font-size: 15px;
    }

    .bio {
      margin: 22px auto;
      color: #ccc;
      font-size: 15px;
      line-height: 1.6;
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 25px;
    }

    .link {
      display: block;
      text-decoration: none;
      color: white;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 15px;
      border-radius: 12px;
      transition: 0.2s;
    }

    .link:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,0.11);
    }

    .footer {
      margin-top: 35px;
      color: #555;
      font-size: 12px;
    }
  </style>
</head>

<body>

  <div class="background"></div>

  <main class="profile">

    <div class="avatar"></div>

    <h1>imadeadhd</h1>

    <div class="username">@imadeadhd</div>

    <p class="bio">
      welcome to my profile<br>
      gaming • discord • roblox
    </p>

    <div class="links">
      <a class="link" href="https://discord.com/" target="_blank">
        Discord
      </a>

      <a class="link" href="https://www.roblox.com/" target="_blank">
        Roblox
      </a>

      <a class="link" href="https://guns.lol/imadeadhd" target="_blank">
        guns.lol
      </a>
    </div>

    <div class="footer">
      imadeadhd.com
    </div>

  </main>

</body>
</html>
